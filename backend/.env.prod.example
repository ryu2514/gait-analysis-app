# 本番環境設定
DEBUG=False
LOG_LEVEL=INFO
ENVIRONMENT=production

# セキュリティ
SECRET_KEY=your-very-secure-secret-key-change-this-in-production
JWT_SECRET=your-jwt-secret-key-change-this-in-production
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# データベース設定
DATABASE_URL=postgresql://gait_user:password@localhost:5432/gait_analysis
DATABASE_ECHO=False

# Redis設定
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=your-redis-password

# Firebase認証設定
FIREBASE_PROJECT_ID=your-production-project-id
FIREBASE_PRIVATE_KEY_ID=your-private-key-id
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nyour-private-key\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
FIREBASE_CLIENT_ID=your-client-id
FIREBASE_AUTH_URI=https://accounts.google.com/o/oauth2/auth
FIREBASE_TOKEN_URI=https://oauth2.googleapis.com/token

# Google Cloud Storage
GCS_BUCKET_NAME=your-production-gcs-bucket
GOOGLE_APPLICATION_CREDENTIALS=/app/credentials/service-account.json

# MediaPipe設定
MEDIAPIPE_MODEL_COMPLEXITY=1
MEDIAPIPE_MIN_DETECTION_CONFIDENCE=0.7
MEDIAPIPE_MIN_TRACKING_CONFIDENCE=0.5

# 動画処理設定
MAX_VIDEO_SIZE_MB=100
MAX_VIDEO_DURATION_SECONDS=30
TARGET_FPS=30
SUPPORTED_VIDEO_FORMATS=["mp4","avi","mov","mkv"]

# 歩行分析設定
MIN_GAIT_CYCLES=2
SYMMETRY_THRESHOLD_PERCENT=10.0

# CORS設定
ALLOWED_ORIGINS=["https://yourdomain.com","https://www.yourdomain.com","https://app.yourdomain.com"]

# レート制限
RATE_LIMIT_PER_MINUTE=60
UPLOAD_RATE_LIMIT_PER_MINUTE=10

# 監視設定
SENTRY_DSN=your-sentry-dsn-url
ENABLE_METRICS=True
METRICS_PORT=9090

# ログ設定
LOG_FILE_PATH=/app/logs/app.log
LOG_MAX_SIZE_MB=100
LOG_BACKUP_COUNT=5

# セッション設定
SESSION_TIMEOUT_MINUTES=60
MAX_CONCURRENT_SESSIONS=5

# ファイル保存設定
UPLOAD_DIR=/app/data/uploads
PROCESSED_DIR=/app/data/processed
REPORTS_DIR=/app/data/reports
TEMP_DIR=/tmp

# SSL/TLS設定
SSL_KEYFILE=/app/ssl/private.key
SSL_CERTFILE=/app/ssl/certificate.crt
SSL_CA_CERTS=/app/ssl/ca-bundle.crt