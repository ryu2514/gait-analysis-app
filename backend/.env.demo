# Demo Environment Configuration
ENVIRONMENT=demo
DEBUG=true
LOG_LEVEL=INFO

# Application Settings
APP_NAME="Gait Analysis Demo"
APP_VERSION="2.0.0-enhanced"
API_PREFIX="/api/v1"

# Enhanced Features
ENABLE_ENHANCED_FEATURES=true
ENABLE_30S_OPTIMIZATION=true
ENABLE_PARALLEL_PROCESSING=true
ENABLE_COMPENSATION_DETECTION=true
ENABLE_BALANCE_ANALYSIS=true

# Performance Settings
MAX_WORKERS=4
TARGET_PROCESSING_TIME_SEC=30
FAST_MODE_THRESHOLD_SEC=25
MAX_VIDEO_SIZE_MB=100
MAX_VIDEO_DURATION_SEC=30
FRAME_PROCESSING_BATCH_SIZE=50

# Demo Limitations
DEMO_MODE=true
MAX_DAILY_ANALYSES=50
MAX_CONCURRENT_USERS=10
DEMO_WATERMARK=true

# Database Configuration
DATABASE_URL="postgresql://demo_user:demo_password_2024@postgres-demo:5432/gait_analysis_demo"
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# Redis Configuration
REDIS_URL="redis://redis-demo:6379/0"
REDIS_CACHE_TTL=3600
REDIS_MAX_CONNECTIONS=20

# MediaPipe Settings
MEDIAPIPE_MODEL_COMPLEXITY=2
MEDIAPIPE_MIN_DETECTION_CONFIDENCE=0.5
MEDIAPIPE_MIN_TRACKING_CONFIDENCE=0.5
MEDIAPIPE_ENABLE_SEGMENTATION=false
MEDIAPIPE_SMOOTH_LANDMARKS=true

# File Storage
UPLOAD_FOLDER="/app/uploads"
REPORTS_FOLDER="/app/reports"
STATIC_FOLDER="/app/static"
TEMP_FOLDER="/tmp"

# Security
SECRET_KEY="demo-secret-key-2024-gait-analysis"
ACCESS_TOKEN_EXPIRE_MINUTES=30
CORS_ORIGINS="http://localhost:3000,http://localhost:80,http://127.0.0.1:3000"

# Monitoring
ENABLE_METRICS=true
METRICS_PORT=8001
PROMETHEUS_ENABLED=true

# Demo Data
DEMO_VIDEO_PATH="/app/demo_data/videos"
DEMO_REPORTS_PATH="/app/demo_data/reports"
SAMPLE_DATA_ENABLED=true

# Feature Flags
FEATURE_ENHANCED_JOINT_ANGLES=true
FEATURE_COMPENSATION_ALERTS=true
FEATURE_BALANCE_METRICS=true
FEATURE_ENHANCED_OUTPUT=true
FEATURE_REAL_TIME_MONITORING=true

# API Rate Limiting
RATE_LIMIT_PER_MINUTE=30
RATE_LIMIT_BURST=10

# Logging
LOG_FORMAT="json"
LOG_FILE="/app/logs/gait_analysis_demo.log"
LOG_ROTATION_SIZE="10MB"
LOG_RETENTION_DAYS=7